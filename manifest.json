{
  "manifest_version": 3,
  "name": "Rikai",
  "version": "0.1.0",
  "description": "Translate raw manga and webtoons directly on the page where you read them.",
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": [
        "lib/tesseract/tesseract.min.js",
        "content/image-extractor.js",
        "content/ocr.js",
        "content/translator.js",
        "content/content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "lib/tesseract/tesseract.min.js",
        "lib/tesseract/worker.min.js",
        "lib/tesseract/tesseract-core-simd.wasm.js",
        "lib/tesseract/tesseract-core-simd-lstm.wasm.js",
        "lib/tesseract/tesseract-core.wasm.js",
        "lib/tesseract/tesseract-core-lstm.wasm.js"
      ],
      "matches": ["<all_urls>"]
    }
  ]
}
