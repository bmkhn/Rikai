{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "allowJs": true,
    "checkJs": false,
    "outDir": "./dist",
    "rootDir": ".",
    "types": ["chrome"]
  },
  "include": [
    "background.ts",
    "content/**/*.ts",
    "offscreen/**/*.ts",
    "popup/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "scripts/**/*.js",
    "offscreen/offscreen-ocr-src.ts"
  ]
}
